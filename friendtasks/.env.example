# Supabase Projekt-URL und anon/public Key (Settings -> API im Supabase Dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Service-Role-Key: NIEMALS mit NEXT_PUBLIC_ prefixen, nur serverseitig verwendet
# (Account-Löschung, siehe lib/supabase/admin.ts). Aus Settings -> API -> service_role.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key
